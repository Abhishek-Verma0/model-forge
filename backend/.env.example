# Copy to backend/.env. These are DEPLOYMENT settings -- they differ per machine,
# never per analysis. Values below are the built-in defaults, so an absent .env
# behaves identically; uncomment only what you change.
#
# Analysis parameters (split ratio, seed, outlier fences, detector thresholds)
# are NOT here on purpose -- you set those in the Preprocessing tab, and they get
# recorded with the run so it reproduces.

# --- LLM. The app works with no LLM at all; only the AI tabs return 503. ---
# Backends: "ollama" (a model on this machine), "huggingface", "gemini".
# You rarely need to set this -- HF_TOKEN or GEMINI_API_KEY picks its own
# provider; set it explicitly only to override that.
# LLM_PROVIDER=huggingface
# LLM_TIMEOUT=500

# Try the other CONFIGURED backends when the chosen one errors or is unreachable
# (order: huggingface, gemini, ollama). Off by default because a fallback can move
# your data from a local model to a hosted one -- that should be a decision.
# LLM_FALLBACK=true

# Local: set OLLAMA_MODEL to whatever `ollama list` shows.
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=qwen3.5:9b
# Tokens the local model may read per request. Longer requests fail with a clear
# error instead of being cut. Bigger = longer prompts fit, but more GPU memory and
# slower answers (measured on an 8 GB GPU: 4096 -> 57 tokens/s, 16384 -> 28 tokens/s).
# OLLAMA_NUM_CTX=16384

# Hosted: no GPU needed, but your column names and sample rows are sent to
# Hugging Face. Token: https://huggingface.co/settings/tokens
# Setting HF_TOKEN alone switches the app to Hugging Face -- keep these commented
# until you have a real token.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_URL=https://router.huggingface.co/v1/chat/completions

# Hosted: Google Gemini. Setting GEMINI_API_KEY alone switches the app to Gemini.
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-2.5-flash

# --- server ---
# Comma-separated. Add your deployed frontend origin before going live.
# CORS_ORIGINS=http://localhost:3000
# MAX_UPLOAD_MB=200
# Datasets kept in memory at once (disk is the source of truth).
# STORE_CAP=5
# Datasets, pipelines and training runs are saved here (default backend/data).
# DATA_DIR=D:/model-forge-data

# --- Database & Auth ---
# PostgreSQL connection string (defaults to local PostgreSQL, or SQLite if configured)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/modelforge
# JWT_SECRET_KEY=replace-with-a-secure-random-secret
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
